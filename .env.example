PANGRAM_API_KEY=
PORT=3000
# Optional: open the site with ?admin=<this value> to remove any leaf
ADMIN_TOKEN=
# Optional: secret that signs freshly scored leaves (defaults to PANGRAM_API_KEY)
LEAF_SECRET=
# Optional locally, required on Vercel: Upstash Redis REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
